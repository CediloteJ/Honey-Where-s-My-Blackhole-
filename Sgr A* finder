<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sgr A* Observation Planner</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://pyscript.net/releases/2024.1.1/core.css">
  <script type="module" src="https://pyscript.net/releases/2024.1.1/core.js"></script>

  <py-config>
    packages = ["numpy", "matplotlib", "astropy", "requests"]
  </py-config>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen p-6 font-sans">

  <div class="max-w-4xl mx-auto space-y-6">
    <header class="text-center space-y-2">
      <h1 class="text-3xl font-bold text-yellow-400">Sgr A* Optimal Wire Orientation & Track</h1>
      <p class="text-gray-400 text-sm">Step 1: see the path. Step 2: enter your hours, get the wire angles.</p>
    </header>

    <!-- STEP 1: Date input -->
    <div class="bg-gray-800 p-6 rounded-xl shadow-lg border border-gray-700 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4 w-full md:w-auto">
        <label for="dateTimeInput" class="font-medium text-gray-300 whitespace-nowrap">Observation Date (UTC):</label>
        <input type="text" id="dateTimeInput" value="2026-09-15 18:00:00" class="bg-gray-700 border border-gray-600 px-3 py-2 rounded text-white font-mono w-full md:w-auto">
      </div>
      <button id="path-btn" py-click="show_path" class="w-full md:w-auto bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold py-2 px-6 rounded-lg transition duration-200">
        Show Sky Path
      </button>
    </div>

    <!-- Output Terminal -->
    <div class="bg-black p-6 rounded-xl border border-gray-800 font-mono text-green-400 shadow-2xl overflow-x-auto whitespace-pre">
      <div id="terminal-out">Loading astronomical modules... Please wait...</div>
    </div>

    <!-- Plots -->
    <div class="space-y-6">
      <div id="plot1-out" class="w-full flex justify-center bg-gray-800 p-4 rounded-xl border border-gray-700"></div>
      <div id="plot2-out" class="w-full flex justify-center bg-gray-800 p-4 rounded-xl border border-gray-700"></div>
    </div>

    <!-- STEP 2: Observing hours (hidden until path is shown) -->
    <div id="window-controls" class="hidden bg-gray-800 p-6 rounded-xl shadow-lg border border-gray-700 space-y-4">
      <p class="text-gray-300 font-medium">Now enter the hours (UTC) you'll actually be out there:</p>
      <div class="flex flex-col md:flex-row items-center gap-4">
        <label for="obsStartInput" class="font-medium text-gray-300 whitespace-nowrap w-40">Start (UTC):</label>
        <input type="text" id="obsStartInput" value="2026-09-16 00:00:00" class="bg-gray-700 border border-gray-600 px-3 py-2 rounded text-white font-mono w-full">
      </div>
      <div class="flex flex-col md:flex-row items-center gap-4">
        <label for="obsEndInput" class="font-medium text-gray-300 whitespace-nowrap w-40">End (UTC):</label>
        <input type="text" id="obsEndInput" value="2026-09-16 03:00:00" class="bg-gray-700 border border-gray-600 px-3 py-2 rounded text-white font-mono w-full">
      </div>
      <button id="optimize-btn" py-click="optimize_window" class="w-full md:w-auto bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold py-2 px-6 rounded-lg transition duration-200">
        Calculate Best Wire Orientation
      </button>
    </div>
  </div>

  <script type="py">
import requests
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.dates as mdates
from astropy.coordinates import EarthLocation, SkyCoord, AltAz
from astropy.time import Time
import astropy.units as u
from pyscript import Element, display

target_name = 'Sgr A*'
h_meters = 3.0
freq_hz = 20.1e6
c = 3.0e8

# Filled in by show_path(), reused by optimize_window()
state = {}

def draw_track(highlight_start=None, highlight_end=None):
    dt_list = state["dt_list"]
    alt = state["alt"]
    az = state["az"]
    r_dist = state["r_dist"]
    hourly = state["hourly"]
    lat, lon = state["lat"], state["lon"]
    times_fine = state["times_fine"]

    Element("plot1-out").element.innerHTML = ""
    Element("plot2-out").element.innerHTML = ""

    window_mask_fine = None
    if highlight_start is not None:
        window_mask_fine = (times_fine >= highlight_start) & (times_fine <= highlight_end)

    # Polar sky track
    fig1 = plt.figure(figsize=(7, 7), facecolor='black')
    ax1 = fig1.add_subplot(111, polar=True, facecolor='#001144')
    ax1.set_theta_zero_location('N')
    ax1.set_theta_direction(1)
    ax1.set_ylim(0, 90)
    ax1.set_yticks([30, 60, 90])
    ax1.set_yticklabels(['', '', ''])
    ax1.grid(color='#4466aa', linestyle='--', linewidth=0.8)
    ax1.set_xticks(np.radians([0, 90, 180, 270]))
    ax1.set_xticklabels(['N', 'E', 'S', 'W'], color='yellow', fontsize=12, fontweight='bold')

    r_plot = r_dist.copy()
    r_plot[alt < 0] = np.nan
    label = 'Full pass' if window_mask_fine is not None else 'Sgr A* path'
    ax1.plot(az, r_plot, color='#446688' if window_mask_fine is not None else '#ff7700',
             lw=1.5 if window_mask_fine is not None else 2, alpha=0.6 if window_mask_fine is not None else 1.0,
             label=label)

    if window_mask_fine is not None:
        r_window = r_dist.copy()
        r_window[~(window_mask_fine & (alt >= 0))] = np.nan
        ax1.plot(az, r_window, color='#ff7700', lw=3, label='Your observing window')

    for i in np.where(hourly & (alt >= 0))[0]:
        ax1.plot(az[i], r_dist[i], 'o', color='yellow', markersize=4)
        ax1.annotate(dt_list[i].strftime('%H:%M'), xy=(az[i], r_dist[i]), xytext=(0, 10),
                     textcoords='offset points', ha='center', color='yellow', fontsize=9)

    ax1.legend(loc='upper right', bbox_to_anchor=(1.35, 1.1), facecolor='black', labelcolor='white', fontsize=8)
    plt.title(f"Sky Track for {target_name}\n({lat:.2f} deg, {lon:.2f} deg)", color='white', pad=15)
    plt.tight_layout()
    display(fig1, target="plot1-out")
    plt.close(fig1)

    # Altitude vs time
    fig2, ax2 = plt.subplots(figsize=(8, 4))
    ax2.plot(dt_list, alt, color='navy', lw=2, label=f'{target_name}')
    ax2.axhline(0, color='red', linestyle='--', label='Horizon')
    if highlight_start is not None:
        ax2.axvspan(highlight_start.to_datetime(), highlight_end.to_datetime(), color='orange', alpha=0.25, label='Your window')

    for i in np.where(hourly & (alt > 0))[0]:
        ax2.annotate(dt_list[i].strftime('%H:%M'), (dt_list[i], alt[i]),
                     textcoords="offset points", xytext=(0, 6), ha='center', fontsize=8)

    ax2.xaxis.set_major_formatter(mdates.DateFormatter('%H:%M'))
    ax2.xaxis.set_major_locator(mdates.HourLocator(interval=2))
    fig2.autofmt_xdate()

    ax2.set_title(f'{target_name} Altitude vs. Time (UTC)')
    ax2.set_xlabel('Time (UTC)')
    ax2.set_ylabel('Altitude (degrees)')
    ax2.set_ylim(-90, max(max(alt) + 15, 25))
    ax2.fill_between(dt_list, alt, 0, where=(alt <= 0), color='gray', alpha=0.3, label='Below Horizon')
    ax2.grid(True, linestyle=':', alpha=0.6)
    ax2.legend(loc='lower right')
    plt.tight_layout()
    display(fig2, target="plot2-out")
    plt.close(fig2)

def show_path(event=None):
    Element("terminal-out").element.innerText = "Running calculations..."
    Element("window-controls").element.classList.add("hidden")

    date_str = Element("dateTimeInput").element.value

    try:
        r = requests.get('https://ipapi.co/json/').json()
        lat, lon = float(r['latitude']), float(r['longitude'])
    except Exception:
        lat, lon = 34.20, -79.76

    location = EarthLocation(lat=lat * u.deg, lon=lon * u.deg, height=0 * u.m)
    target = SkyCoord.from_name(target_name)

    times_fine = Time(date_str) + np.arange(0, 24 * 60, 1) * u.minute
    dt_list = np.array([t.to_datetime() for t in times_fine])
    altaz_fine = target.transform_to(AltAz(obstime=times_fine, location=location))
    alt = altaz_fine.alt.deg
    az = altaz_fine.az.rad
    r_dist = 90 - alt
    hourly = np.array([dt.minute == 0 for dt in dt_list])

    # Save everything so step 2 doesn't have to recompute
    state["date_str"] = date_str
    state["location"] = location
    state["target"] = target
    state["lat"] = lat
    state["lon"] = lon
    state["times_fine"] = times_fine
    state["dt_list"] = dt_list
    state["alt"] = alt
    state["az"] = az
    state["r_dist"] = r_dist
    state["hourly"] = hourly

    above_horizon_indices = np.where(alt > 0)[0]

    term_text = f" SKY PATH FOR {target_name}\n"
    term_text += f" Observer Location : {lat:.2f} deg, {lon:.2f} deg\n\n"

    if len(above_horizon_indices) > 0:
        max_alt_idx = np.argmax(alt)
        rise_time = dt_list[above_horizon_indices[0]]
        peak_time = dt_list[max_alt_idx]
        set_time = dt_list[above_horizon_indices[-1]]
        term_text += f"Rises Above Horizon : {rise_time.strftime('%Y-%m-%d %H:%M UTC')}\n"
        term_text += f"Peak Altitude       : {alt[max_alt_idx]:.2f} deg at {peak_time.strftime('%H:%M UTC')}\n"
        term_text += f"Sets Below Horizon  : {set_time.strftime('%Y-%m-%d %H:%M UTC')}\n\n"
        term_text += "Enter the hours below that you'll actually be observing, then click Calculate.\n"
        Element("window-controls").element.classList.remove("hidden")
    else:
        term_text += "Target does not rise above the horizon during this 24-hour window.\n"

    Element("terminal-out").element.innerText = term_text
    draw_track()

def optimize_window(event=None):
    if "location" not in state:
        Element("terminal-out").element.innerText = "Click 'Show Sky Path' first."
        return

    obs_start_str = Element("obsStartInput").element.value
    obs_end_str = Element("obsEndInput").element.value

    try:
        observe_start = Time(obs_start_str)
        observe_end = Time(obs_end_str)
    except Exception:
        Element("terminal-out").element.innerText = "Could not parse start/end times. Use format YYYY-MM-DD HH:MM:SS (UTC)."
        return

    location = state["location"]
    target = state["target"]
    lat, lon = state["lat"], state["lon"]

    # Re-sample at 5-min resolution just for the optimization search
    times = Time(state["date_str"]) + np.arange(0, 24 * 60, 5) * u.minute
    altaz = target.transform_to(AltAz(obstime=times, location=location))

    above_horizon = altaz.alt.deg > 0
    window_mask = (times >= observe_start) & (times <= observe_end)
    visible_mask = above_horizon & window_mask

    term_text = f" OPTIMAL WIRE ORIENTATION FOR {target_name} DURING YOUR OBSERVING WINDOW\n"
    term_text += f" Observer Location : {lat:.2f} deg, {lon:.2f} deg\n"
    term_text += f" Observing Window (UTC): {observe_start.iso} to {observe_end.iso}\n\n"

    if not np.any(visible_mask):
        term_text += "WARNING: Sgr A* is NOT above the horizon during your chosen observing window.\n"
        if np.any(above_horizon):
            rise_time = times[above_horizon][0]
            set_time = times[above_horizon][-1]
            term_text += f"It is actually visible from {rise_time.iso} to {set_time.iso} UTC.\n"
        term_text += "Adjust the start/end above so they overlap that range, then click Calculate again.\n"
        Element("terminal-out").element.innerText = term_text
        return

    sgr_az_rad = altaz.az.rad[visible_mask]
    sgr_elev_rad = altaz.alt.rad[visible_mask]

    h_over_lambda = h_meters / (c / freq_hz)
    ground_factor = np.abs(np.sin(2 * np.pi * h_over_lambda * np.sin(sgr_elev_rad)))

    best_score = -1.0
    best_w1_angle = 0
    best_w2_angle = 90

    for w1_deg in range(0, 95, 5):
        w1_rad = np.radians(w1_deg)
        w2_rad = np.radians(w1_deg + 90)

        dot1 = np.cos(sgr_elev_rad) * np.cos(sgr_az_rad - w1_rad)
        gain_w1 = np.sqrt(np.maximum(0, 1 - dot1**2))

        dot2 = np.cos(sgr_elev_rad) * np.cos(sgr_az_rad - w2_rad)
        gain_w2 = np.sqrt(np.maximum(0, 1 - dot2**2))

        total_gain = np.sqrt(gain_w1**2 + gain_w2**2) * ground_factor
        score = np.sum(total_gain)

        if score > best_score:
            best_score = score
            best_w1_angle = w1_deg
            best_w2_angle = w1_deg + 90

    term_text += f" Target Alt Range in Window: {np.min(altaz.alt.deg[visible_mask]):.1f} deg to {np.max(altaz.alt.deg[visible_mask]):.1f} deg\n\n"
    term_text += f" BEST SETUP FOUND \n"
    term_text += f" Wire 1 Angle    : {best_w1_angle} deg from North\n"
    term_text += f" Wire 2 Angle    : {best_w2_angle} deg from North\n"

    Element("terminal-out").element.innerText = term_text
    draw_track(highlight_start=observe_start, highlight_end=observe_end)

Element("terminal-out").element.innerText = "Enter a date and click 'Show Sky Path' to begin."
  </script>
</body>
</html>
